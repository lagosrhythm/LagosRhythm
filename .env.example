# Lagos Rhythm WebApp - Environment Template
# Copy this file to .env.local and fill in real values.
# Do not commit .env.local.

# Firebase (Web SDK - required for core content/auth flows)
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=

# Firebase Admin (server only - API routes, Clerk -> Firebase sign-in, bookings)
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# Clerk (recommended; app currently falls back to keyless mode if not set)
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# Flutterwave (booking/payment UI)
NEXT_PUBLIC_FLUTTERWAVE_API_KEY=
# Secret key - server only. Used to verify payments before bookings are saved.
FLUTTERWAVE_SECRET_KEY=

# Exchange rate service (server only, served to the browser through /api/rates)
EXCHANGERATE_API_KEY=

# EmailJS (booking/newsletter notifications)
NEXT_PUBLIC_EMAILJS_SERVICE_ID=
NEXT_PUBLIC_EMAILJS_BOOKING_CONFIRMATION_TEMPLATE_ID=
NEXT_PUBLIC_EMAILJS_NEWSLETTER_CONFIRMATION_TEMPLATE_ID=
NEXT_PUBLIC_EMAILJS_PUBLIC_KEY=

# Mailbox validation (server only, used by /api/validate-email)
MAILBOX_API_KEY=

# Admin accounts (comma separated). Defaults to the built-in list when empty.
NEXT_PUBLIC_ADMIN_EMAILS=

# Public site URL (payment redirects)
NEXT_PUBLIC_SITE_URL=https://www.lagosrhythm.com

# Live stream / sockets
NEXT_PUBLIC_SOCKET_URL=

# Optional server integrations
NOWPAYMENTS_API_KEY=
GOOGLE_MAPS_API_KEY=
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=
NEXT_PUBLIC_GOOGLE_MAPS_EMBED_API_KEY=

# Street Rhythm import tooling only (local script usage)
FIREBASE_SERVICE_ACCOUNT_PATH=
