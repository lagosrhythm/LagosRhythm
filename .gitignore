# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# Dependencies
/node_modules/
/.pnp/
.pnp.*

# Package manager caches
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# Testing
/coverage/

# Next.js build outputs
/.next/
/out/

# Production builds and distro
/build/
/dist/

# Vercel
/.vercel/
/.vercel/output/

# Misc
.DS_Store
Thumbs.db
ehthumbs.db
*.pem

# Debug logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# Env files (ignore all env files but allow example)
.env*
!.env.example

# TypeScript
*.tsbuildinfo
next-env.d.ts

# Editor/IDE
.vscode/
.idea/

# Caches
.cache/
.parcel-cache/

# Clerk configuration (may contain secrets)
/.clerk/

# Firebase service account (contains private key - NEVER commit)
/lagos-rhythm-19b8a-firebase-adminsdk-fbsvc-e6381d0620.json
*-firebase-adminsdk-*.json

# Firebase deployment debug logs
firebase-debug.log
firestore-deploy.log
*.log

# Firebase emulator
.firebase/
.firebaserc.local

# Large public media (keep tracked files explicit)
public/hero-video.mp4

# Anniversary edition is generated from Anniversary/site/ at build time
# (npm run anniversary:sync, also run automatically by `npm run build`)
/public/anniversary/

# Note: media/ folder intentionally NOT ignored so project media is tracked
